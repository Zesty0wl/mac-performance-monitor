    "Total CPU above" : {
      "comment" : "SettingsView",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesamt-CPU über"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total CPU above"
          }
        },
        "fr" : {
          "stringUnit" : {
