    "You can switch anytime: in Settings or from the menu bar." : {
      "comment" : "OnboardingView",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst jederzeit wechseln: in den Einstellungen oder über die Menüleiste."
          }
        },
        "en" : {
          "stringUnit" : {
