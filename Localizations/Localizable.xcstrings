    "Cloned files are counted at full size, so the scan exceeds the volume's used figure by their shared blocks." : {
      "comment" : "Disk Map (1.6.0)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geklonte Dateien werden in voller Größe gezählt, daher übersteigt der Scan den belegten Speicherplatz des Volumes um ihre geteilten Blöcke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloned files are counted at full size, so the scan exceeds the volume's used figure by their shared blocks."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers clonés sont comptés à leur taille complète ; l'analyse dépasse donc l'espace utilisé du volume de la taille de leurs blocs partagés."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "克隆文件按完整大小计入，因此扫描结果会比宗卷已用空间多出其共享块的部分。"
          }
        }
      }
    },
