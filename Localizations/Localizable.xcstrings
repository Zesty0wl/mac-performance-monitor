    "Memory pressure is high or could not be read. %@ needs normal memory pressure to run. Close unused apps, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Speicherdruck ist hoch oder konnte nicht gelesen werden. %@ benötigt normalen Speicherdruck. Schließe ungenutzte Apps und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memory pressure is high or could not be read. %@ needs normal memory pressure to run. Close unused apps, then try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pression mémoire est élevée ou n'a pas pu être lue. %@ nécessite une pression mémoire normale. Fermez les apps inutilisées, puis réessayez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内存压力较高或无法读取。%@ 需要正常的内存压力才能运行。请关闭不用的 App，然后重试。"
          }
        }
      }
    },
    "Memory or thermal pressure is too high for %@. Use the current report instead." : {
