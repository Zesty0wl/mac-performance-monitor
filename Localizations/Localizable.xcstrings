      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere die Netzwerkerfassung pro App, um zu sehen, welche Apps das Netzwerk nutzen. Sie ist standardmäßig aus, weil dafür ein zusätzliches Systemwerkzeug läuft."
          }
        },
        "en" : {
