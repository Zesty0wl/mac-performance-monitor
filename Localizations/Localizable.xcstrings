    "IOAccelerator `Device Utilization %`, read from the IORegistry once a second; the sparkline is the value over the selected range." : {
      "comment" : "Metric Cards & Explanations",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IOAccelerator `Device Utilization %`, einmal pro Sekunde aus der IORegistry gelesen; die Sparkline zeigt den Wert über den gewählten Bereich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IOAccelerator `Device Utilization %`, read from the IORegistry once a second; the sparkline is the value over the selected range."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IOAccelerator `Device Utilization %`, lu dans l'IORegistry une fois par seconde ; la courbe miniature représente la valeur sur la plage sélectionnée."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IOAccelerator 中的“Device Utilization %”，每秒从 IORegistry 读取一次；火花线显示所选时间范围内的数值。"
          }
        }
      }
    },
    "IOAccelerator `In use system memory`; the allocated figure in the Device panel is the larger amount reserved to GPU clients including cached allocations." : {
      "comment" : "Metric Cards & Explanations",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IOAccelerator `In use system memory`; der Wert „Zugewiesen“ im Bereich „Gerät“ ist die größere Menge, die GPU-Clients einschließlich gecachter Zuweisungen vorbehalten ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IOAccelerator `In use system memory`; the allocated figure in the Device panel is the larger amount reserved to GPU clients including cached allocations."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IOAccelerator `In use system memory` ; la valeur allouée dans le panneau Appareil est le montant plus important réservé aux clients GPU, allocations en cache comprises."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IOAccelerator 中的“In use system memory”；设备面板中的已分配数值是为 GPU 客户端保留的更大空间，包含已缓存的分配。"
          }
        }
      }
    },
