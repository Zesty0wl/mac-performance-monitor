        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farbe danach, wie sicher das Entfernen ist: Caches grün, deine Dateien blau, von Apps verwaltete orange, macOS grau."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colour by how safe it is to remove: caches in green, your files in blue, app-managed in orange, macOS in grey."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couleur selon la sûreté de la suppression : caches en vert, vos fichiers en bleu, gérés par les apps en orange, macOS en gris."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按移除安全程度着色：缓存为绿色，你的文件为蓝色，应用管理的为橙色，macOS 为灰色。"
          }
        }
      }
    },
