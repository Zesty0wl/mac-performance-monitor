    "One hue, darker the deeper an item sits in the folder tree." : {
      "comment" : "Disk Map (1.6.0)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Farbton, umso dunkler, je tiefer ein Objekt im Ordnerbaum liegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One hue, darker the deeper an item sits in the folder tree."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une seule teinte, d'autant plus foncée que l'élément est profond dans l'arborescence des dossiers."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单一色相，项目在文件夹树中越深颜色越暗。"
          }
        }
      }
    },
    "One process is running translated under Rosetta. Apple-silicon-native versions typically need less memory and CPU." : {
      "comment" : "Identity entries: English renders the key verbatim. Present so the two tables mirror each other and English copy stays auditable in one place; check-localization.py enforces the parity.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Prozess läuft übersetzt unter Rosetta. Native Apple-Silicon-Versionen brauchen in der Regel weniger Speicher und CPU."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One process is running translated under Rosetta. Apple-silicon-native versions typically need less memory and CPU."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un processus s'exécute en mode traduit sous Rosetta. Les versions natives Apple Silicon ont généralement besoin de moins de mémoire et de CPU."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 1 个进程正在 Rosetta 转译下运行。Apple Silicon 原生版本通常占用更少的内存和 CPU。"
          }
        }
      }
