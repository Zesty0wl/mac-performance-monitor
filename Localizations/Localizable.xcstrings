    "Average device service time across measured disks, not an app's wait time. Compare it during and after the symptom." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mittlere Bearbeitungszeit der gemessenen Festplatten, nicht die Wartezeit einer App. Vergleiche sie während und nach dem Problem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Average device service time across measured disks, not an app's wait time. Compare it during and after the symptom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temps de service moyen des disques mesurés, pas le temps d'attente d'une app. Comparez-le pendant et après le symptôme."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有测量磁盘的平均设备服务时间，并非 App 的等待时间。请比较症状出现时和消失后的情况。"
          }
        }
      }
    },
    "Disk busy time and latency are unavailable. Free space alone cannot establish a disk bottleneck." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Festplattenauslastung und Latenz sind nicht verfügbar. Freier Platz allein belegt keinen Festplattenengpass."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk busy time and latency are unavailable. Free space alone cannot establish a disk bottleneck."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps d'occupation et la latence du disque sont indisponibles. L'espace libre seul ne démontre pas un goulot d'étranglement disque."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法获取磁盘繁忙时间和延迟。仅凭可用空间无法确定磁盘瓶颈。"
          }
        }
      }
    },
    "Process disk reads and writes. This may not match physical disk activity because of caching and shared work." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lese- und Schreibzugriffe des Prozesses. Wegen Zwischenspeicherung und gemeinsamer Arbeit können sie von der physischen Festplattenaktivität abweichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Process disk reads and writes. This may not match physical disk activity because of caching and shared work."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lectures et écritures disque du processus. Le cache et le travail partagé peuvent les faire différer de l'activité physique du disque."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进程的磁盘读取和写入。由于缓存及共享任务，此数据可能与物理磁盘活动不同。"
          }
        }
      }
    },
