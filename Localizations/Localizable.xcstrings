    "%@ appears in the Dock whenever one of its windows is open, which is also what gives it the usual menus. Turn this on to keep it in the Dock while it runs in the background with no window open." : {
      "comment" : "SettingsView",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ erscheint im Dock, sobald eines seiner Fenster geöffnet ist; das ist auch der Grund, warum es dann die üblichen Menüs hat. Aktiviere dies, um es im Dock zu behalten, während es ohne geöffnetes Fenster im Hintergrund läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ appears in the Dock whenever one of its windows is open, which is also what gives it the usual menus. Turn this on to keep it in the Dock while it runs in the background with no window open."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ apparaît dans le Dock dès qu’une de ses fenêtres est ouverte, ce qui lui donne aussi les menus habituels. Activez cette option pour le garder dans le Dock pendant qu’il fonctionne en arrière-plan sans fenêtre ouverte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要 %@ 的任一窗口处于打开状态，它就会出现在程序坞中，这也是它拥有常规菜单的原因。开启此项可让它在后台无窗口运行时仍保留在程序坞中。"
          }
        }
      }
    },
    "%@ bytes" : {
      "comment" : "Identity entries: English renders the key verbatim. Present so the two tables mirror each other and English copy stays auditable in one place; check-localization.py enforces the parity.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
