        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当系统达到严重压力且应用可能被迫退出时通知。"
          }
        }
      }
    },
    "Notify when the system writes more than the chosen amount to swap." : {
