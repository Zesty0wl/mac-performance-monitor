          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 没有内置电池，因此电量、健康度和运行时间不适用。系统功耗是整台机器的测量功耗；上方的能耗影响列出了哪些应用消耗最多。"
          }
        }
      }
    },
