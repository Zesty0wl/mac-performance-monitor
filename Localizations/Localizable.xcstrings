    "Latest sample, not selected-range history" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letzte Messung, nicht der gewählte Verlauf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latest sample, not selected-range history"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dernière mesure, pas l'historique de la période choisie"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近一次采样，而非所选时段的历史数据"
          }
        }
      }
    },
    "macOS groups GPU memory traffic by speed. Bars show the share of reported events in each bin. This is not GPU load or a share of peak bandwidth." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS gruppiert GPU-Speicherzugriffe nach Geschwindigkeit. Die Balken zeigen den Anteil der gemeldeten Ereignisse je Klasse. Dies ist weder die GPU-Auslastung noch ein Anteil der maximalen Bandbreite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS groups GPU memory traffic by speed. Bars show the share of reported events in each bin. This is not GPU load or a share of peak bandwidth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS regroupe le trafic mémoire du GPU par débit. Les barres montrent la part des événements signalés dans chaque classe. Ce n'est ni la charge GPU ni une part de la bande passante maximale."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 按速度对 GPU 内存流量分档。柱形表示各档位在所报告事件中所占的比例，并不代表 GPU 负载或峰值带宽的使用比例。"
          }
        }
      }
    },
    "The lowest bin can include no traffic. The top bin may include higher rates. These bins do not give an exact mean in GB/s. Source: IOReport PMP / DCS BW." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die niedrigste Klasse kann auch keine Zugriffe umfassen. Die höchste Klasse kann höhere Raten einschließen. Aus diesen Klassen lässt sich kein genauer Mittelwert in GB/s bestimmen. Quelle: IOReport PMP / DCS BW."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lowest bin can include no traffic. The top bin may include higher rates. These bins do not give an exact mean in GB/s. Source: IOReport PMP / DCS BW."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La classe la plus basse peut inclure l'absence de trafic. La plus haute peut inclure des débits supérieurs. Ces classes ne donnent pas de moyenne exacte en GB/s. Source : IOReport PMP / DCS BW."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最低档可能包括无流量的情况，最高档可能包含更高的速率。这些档位无法给出以 GB/s 为单位的精确平均值。来源：IOReport PMP / DCS BW。"
          }
        }
      }
    },
    "%1$@ bin: %2$@ of reported events" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasse %1$@: %2$@ der gemeldeten Ereignisse"
