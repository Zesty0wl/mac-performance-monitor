        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Frage wird auf diesem Mac verarbeitet. Die KI wählt einen Bericht; Swift liefert die Messdaten. Es wird kein Cloud-Modell verwendet und kein Gespräch gespeichert."
          }
        },
