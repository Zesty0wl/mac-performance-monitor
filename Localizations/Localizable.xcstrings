    "Notify when GPU utilisation stays above the chosen level for a sustained period, for example a model left running. The GPU tab shows who is using it. Off by default." : {
      "comment" : "SettingsView",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigen, wenn die GPU-Auslastung über einen längeren Zeitraum über dem gewählten Wert bleibt, zum Beispiel bei einem Modell, das weiterläuft. Der GPU-Tab zeigt, wer sie nutzt. Standardmäßig aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notify when GPU utilisation stays above the chosen level for a sustained period, for example a model left running. The GPU tab shows who is using it. Off by default."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifier quand l'utilisation du GPU reste au-dessus du niveau choisi pendant une période prolongée, par exemple un modèle laissé en cours d'exécution. L'onglet GPU montre qui l'utilise. Désactivé par défaut."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 GPU 利用率持续一段时间高于所选水平时通知,例如模型一直运行。GPU 标签页会显示谁在使用它。默认关闭。"
          }
        }
      }
    },
    "Notify when a process keeps growing in a way that looks like a memory leak." : {
      "comment" : "SettingsView",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigen, wenn ein Prozess so weiterwächst, dass es wie ein Speicherleck aussieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notify when a process keeps growing in a way that looks like a memory leak."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifier quand un processus continue de grossir d'une manière qui ressemble à une fuite mémoire."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当进程持续增长且看起来像内存泄漏时通知。"
          }
        }
      }
    },
    "Notify when any single process exceeds the chosen memory footprint." : {
      "comment" : "SettingsView",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigen, wenn ein einzelner Prozess den gewählten Speicherbedarf überschreitet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notify when any single process exceeds the chosen memory footprint."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifier quand un seul processus dépasse l'empreinte mémoire choisie."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当任何单个进程超过所选内存占用时通知。"
          }
        }
      }
    },
    "Notify when macOS keeps slowing work down to shed heat, naming the process using the most CPU at that moment." : {
      "comment" : "SettingsView",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigen, wenn macOS die Arbeit wiederholt drosselt, um Wärme abzuführen, mit dem Prozess, der in dem Moment die meiste CPU nutzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notify when macOS keeps slowing work down to shed heat, naming the process using the most CPU at that moment."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifier quand macOS continue de ralentir le travail pour évacuer la chaleur, en nommant le processus qui utilise le plus de CPU à ce moment-là."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 macOS 为散热而持续降低工作速度时通知,并指出当时占用 CPU 最多的进程。"
          }
        }
      }
    },
    "Notify when the system reaches critical pressure and apps may be forced to quit." : {
      "comment" : "SettingsView",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigen, wenn das System kritischen Druck erreicht und Apps möglicherweise beendet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
