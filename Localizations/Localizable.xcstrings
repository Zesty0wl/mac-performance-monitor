      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt die Menüleiste unter die Kameraaussparung, sodass sie von Rand zu Rand reicht und mehr Objekte aufnimmt. Kostet etwas Bildschirmhöhe und gilt für alle Apps."
          }
        },
        "en" : {
          "stringUnit" : {
