    "Hottest CPU die sensor in orange, GPU die in red. The status ends with macOS's own thermal pressure verdict." : {
      "comment" : "DashboardView",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heißester CPU-Die-Sensor in Orange, GPU-Die in Rot. Der Status endet mit der eigenen Einschätzung des thermischen Drucks durch macOS."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hottest CPU die sensor in orange, GPU die in red. The status ends with macOS's own thermal pressure verdict."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capteur le plus chaud de la puce CPU en orange, puce GPU en rouge. L'état se termine par le verdict de macOS sur la pression thermique."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU 芯片最热传感器为橙色,GPU 芯片为红色。状态以 macOS 自身的散热压力判断结尾。"
          }
        }
      }
    },
    "Hover an interval to compare download and upload. Check for downloads, backups, or sync activity at the same time. Enable per-app network tracking in Settings when you need attribution." : {
      "comment" : "Dashboard chart statistics and investigation details. German, French, and Simplified Chinese translations generated by GitHub Copilot; native-speaker review pending.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege den Zeiger über ein Intervall, um Download und Upload zu vergleichen. Prüfe auf gleichzeitige Downloads, Backups oder Synchronisierung. Aktiviere in den Einstellungen die Netzwerkerfassung pro App, wenn du den Datenverkehr zuordnen möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hover an interval to compare download and upload. Check for downloads, backups, or sync activity at the same time. Enable per-app network tracking in Settings when you need attribution."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Survolez un intervalle pour comparer réception et envoi. Recherchez les téléchargements, sauvegardes ou synchronisations simultanés. Activez le suivi réseau par application dans les réglages pour attribuer le trafic."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悬停在时间区间上可比较下载和上传。检查同一时间的下载、备份或同步活动。需要按应用归因时，请在“设置”中启用各应用网络跟踪。"
          }
        }
      }
    },
