    "%@ has been growing steadily and may be leaking memory. If it keeps climbing, restarting it will reclaim the memory." : {
      "comment" : "Identity entries: English renders the key verbatim. Present so the two tables mirror each other and English copy stays auditable in one place; check-localization.py enforces the parity.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wächst stetig und hat möglicherweise ein Speicherleck. Wenn der Wert weiter steigt, gibt ein Neustart den Speicher wieder frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has been growing steadily and may be leaking memory. If it keeps climbing, restarting it will reclaim the memory."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ grossit régulièrement et présente peut-être une fuite mémoire. Si la hausse continue, le relancer permettra de récupérer la mémoire."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的内存一直在稳定增长，可能存在泄漏。如果继续上涨，重启它可以回收这部分内存。"
          }
        }
      }
