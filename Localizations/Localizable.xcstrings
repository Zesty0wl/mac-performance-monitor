          "stringUnit" : {
            "state" : "translated",
            "value" : "Moyenne estimée"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "估算平均值"
          }
        }
      }
    },
    "About estimated GPU bandwidth" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
