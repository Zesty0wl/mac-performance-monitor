        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les échantillons de processus peuvent être espacés. Les moyennes ne prouvent pas une activité continue ; le CPU d'un processus se mesure par rapport à un cœur."
