    "Swap and sleep images; macOS grows and shrinks them itself." : {
      "comment" : "Disk Map (1.6.0)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swap- und Ruhezustands-Images; macOS vergrößert und verkleinert sie selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swap and sleep images; macOS grows and shrinks them itself."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images de swap et de veille ; macOS les agrandit et les réduit lui-même."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交换文件和睡眠映像；macOS 会自行增减它们。"
          }
        }
      }
    },
    "Swap grew %1$@ over the last %2$@ min, from %3$@ to %4$@. A sustained climb means memory is oversubscribed." : {
      "comment" : "Identity entries: English renders the key verbatim. Present so the two tables mirror each other and English copy stays auditable in one place; check-localization.py enforces the parity.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swap ist in den letzten %2$@ Min. um %1$@ gewachsen, von %3$@ auf %4$@. Ein anhaltender Anstieg bedeutet, dass der Speicher überbelegt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swap grew %1$@ over the last %2$@ min, from %3$@ to %4$@. A sustained climb means memory is oversubscribed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le swap a augmenté de %1$@ au cours des %2$@ dernières min, de %3$@ à %4$@. Une hausse soutenue signifie que la mémoire est sursollicitée."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "过去 %2$@ 分钟内 Swap 增长了 %1$@，从 %3$@ 到 %4$@。持续增长意味着内存已超额分配。"
          }
        }
      }
    },
    "Swap has passed %@. Sustained swapping under pressure can slow things down — consider freeing some memory." : {
      "comment" : "Identity entries: English renders the key verbatim. Present so the two tables mirror each other and English copy stays auditable in one place; check-localization.py enforces the parity.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swap hat %@ überschritten. Anhaltendes Auslagern unter Speicherdruck kann alles verlangsamen. Gib etwas Speicher frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swap has passed %@. Sustained swapping under pressure can slow things down — consider freeing some memory."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le swap a dépassé %@. Un swap soutenu sous pression peut ralentir le système : pensez à libérer de la mémoire."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swap 已超过 %@。在内存压力下持续换页会拖慢系统，建议释放一些内存。"
          }
        }
      }
    },
