    "All alerts are off by default except critical pressure and runaway processes. %@ never sends anything off your Mac." : {
      "comment" : "SettingsView",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Warnungen sind standardmäßig aus, außer bei kritischem Speicherdruck und außer Kontrolle geratenen Prozessen. %@ sendet nie etwas von deinem Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All alerts are off by default except critical pressure and runaway processes. %@ never sends anything off your Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les alertes sont désactivées par défaut, sauf la pression critique et les processus hors de contrôle. %@ n'envoie jamais rien hors de votre Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除严重压力和失控进程外,所有提醒默认关闭。%@ 绝不会向您的 Mac 之外发送任何数据。"
          }
        }
      }
    },
