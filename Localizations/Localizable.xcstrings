    "Taken straight from the kernel's swap usage figure (vm.swapusage.xsu_used). Swap lives on disk, not in RAM, so it is shown on its own and is not part of the total-RAM split." : {
      "comment" : "Metric Cards & Explanations",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkt aus dem Swap-Nutzungswert des Kernels übernommen (vm.swapusage.xsu_used). Swap liegt auf der Festplatte, nicht im RAM, und wird daher separat angezeigt und ist nicht Teil der Aufteilung des gesamten RAM."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taken straight from the kernel's swap usage figure (vm.swapusage.xsu_used). Swap lives on disk, not in RAM, so it is shown on its own and is not part of the total-RAM split."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pris directement dans la valeur d’utilisation du swap du noyau (vm.swapusage.xsu_used). Le swap réside sur le disque, pas en RAM ; il est donc affiché à part et ne fait pas partie de la répartition de la RAM totale."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接取自内核的交换使用量数值 (vm.swapusage.xsu_used)。交换内存位于磁盘而非 RAM 中，因此独立显示，不属于总 RAM 划分的一部分。"
          }
        }
      }
    },
    "Takes effect once %@ relaunches." : {
      "comment" : "Disk Map (1.6.0)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird wirksam, sobald %@ neu gestartet wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takes effect once %@ relaunches."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prend effet dès que %@ est relancé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在%@重新启动后生效。"
          }
        }
      }
    },
