        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ gehört einem anderen Benutzer (UID %2$@), daher lässt sich sein Speicher ohne erweiterte Rechte nicht lesen. Aktiviere „Vollständige Abdeckung“ in den Einstellungen, um Systemprozesse und Prozesse anderer Benutzer zu untersuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is owned by another user (UID %2$@), so its memory can't be read without elevated privileges. Enable Full Coverage in Settings to inspect system and other-user processes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ appartient à un autre utilisateur (UID %2$@), sa mémoire ne peut donc pas être lue sans privilèges élevés. Activez la couverture complète dans les Réglages pour inspecter les processus système et ceux des autres utilisateurs."
          }
