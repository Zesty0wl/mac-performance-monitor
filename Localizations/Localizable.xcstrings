        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifier quand le CPU total reste au-dessus du niveau choisi pendant une période prolongée. Désactivé par défaut : un CPU élevé est normal pendant un vrai travail."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
