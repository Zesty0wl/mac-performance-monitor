      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere den aufgezeichneten Verlauf eines oder mehrerer Prozesse in einer komprimierten Datei, die du teilen kannst. Der Empfänger kann sie in %@ öffnen, auch ohne diese Prozesse auf seinem Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save one or more processes' recorded history to a compressed file you can share. The recipient can open it in %@, even without those processes on their Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez l’historique enregistré d’un ou plusieurs processus dans un fichier compressé que vous pouvez partager. Le destinataire peut l’ouvrir dans %@, même sans ces processus sur son Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把一个或多个进程的历史记录保存为一个压缩文件用于分享。对方即使机器上没有这些进程，也能在 %@ 中打开它。"
          }
        }
      }
    },
