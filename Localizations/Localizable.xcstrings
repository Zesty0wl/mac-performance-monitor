    "Hottest CPU die sensor in orange, GPU die in red. The status ends with macOS's own thermal pressure verdict." : {
      "comment" : "DashboardView",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
