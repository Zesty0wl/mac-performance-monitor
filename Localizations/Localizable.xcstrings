    "The answer quoted a number we could not match to its sources. No AI answer is shown. You can still use the measured report." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Antwort enthielt eine Zahl, die sich keiner ihrer Quellen zuordnen ließ. Es wird keine KI-Antwort angezeigt. Der Bericht mit Messwerten bleibt nutzbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The answer quoted a number we could not match to its sources. No AI answer is shown. You can still use the measured report."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réponse citait un nombre que nous n'avons pas pu relier à ses sources. Aucune réponse IA n'est affichée. Le rapport de mesures reste disponible."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答引用了一个无法与来源匹配的数字。AI 回答不会显示，测量报告仍可使用。"
          }
        }
      }
    },
    "The answer did not pass the text or source checks. You can still use the measured report." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Antwort hat die Text- oder Quellenprüfung nicht bestanden. Der Bericht mit Messwerten bleibt nutzbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The answer did not pass the text or source checks. You can still use the measured report."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réponse n'a pas passé les vérifications du texte ou des sources. Le rapport de mesures reste disponible."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答未通过文本或来源检查。测量报告仍可使用。"
          }
        }
      }
    },
    "The model asked for a data check this app does not support. You can still use the measured report." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Modell hat eine Datenprüfung angefordert, die diese App nicht unterstützt. Der Bericht mit Messwerten bleibt nutzbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The model asked for a data check this app does not support. You can still use the measured report."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle a demandé une vérification de données que cette app ne prend pas en charge. Le rapport de mesures reste disponible."
