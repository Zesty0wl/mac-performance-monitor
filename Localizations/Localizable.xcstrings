    "Memory is rising, but the process has only been running {process.uptime} — likely normal start-up growth; re-check once it has been up a while." : {
      "comment" : "Identity entries: English renders the key verbatim. Present so the two tables mirror each other and English copy stays auditable in one place; check-localization.py enforces the parity.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Speicher steigt, aber der Prozess läuft erst seit {process.uptime}: wahrscheinlich normales Wachstum beim Start. Prüfe erneut, wenn er eine Weile gelaufen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memory is rising, but the process has only been running {process.uptime} — likely normal start-up growth; re-check once it has been up a while."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mémoire augmente, mais le processus ne tourne que depuis {process.uptime} : c'est probablement la croissance normale du démarrage. Revérifiez quand il aura tourné un moment."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内存在上升，但该进程才运行了 {process.uptime}，多半是正常的启动期增长；等它跑一段时间后再看。"
          }
        }
      }
    },
