    "Off. %@ shows only the processes it can read at user level." : {
      "comment" : "SettingsView",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus. %@ zeigt nur die Prozesse, die es auf Benutzerebene lesen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off. %@ shows only the processes it can read at user level."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé. %@ n'affiche que les processus qu'il peut lire au niveau utilisateur."
