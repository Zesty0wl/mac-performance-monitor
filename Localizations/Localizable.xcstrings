    },
    "Free space as a share of reported capacity. Low space is a storage concern, not evidence of slow disk I/O." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freier Platz als Anteil der gemeldeten Kapazität. Wenig Platz ist ein Speicherproblem, aber kein Beleg für langsame Festplattenzugriffe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free space as a share of reported capacity. Low space is a storage concern, not evidence of slow disk I/O."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Part libre de la capacité indiquée. Un espace réduit est un problème de stockage, pas une preuve d'entrées-sorties lentes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用空间占报告容量的比例。空间不足属于存储问题，但不能证明磁盘读写缓慢。"
          }
        }
      }
    },
