    },
    "macOS hides the Wi-Fi name and BSSID unless Location Services is enabled for %@." : {
      "comment" : "Identity entries: English renders the key verbatim. Present so the two tables mirror each other and English copy stays auditable in one place; check-localization.py enforces the parity.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS blendet den Wi-Fi-Namen und die BSSID aus, solange die Ortungsdienste für %@ nicht aktiviert sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hides the Wi-Fi name and BSSID unless Location Services is enabled for %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS masque le nom du réseau Wi-Fi et le BSSID tant que le service de localisation n'est pas activé pour %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非为 %@ 开启定位服务，否则 macOS 会隐藏 Wi-Fi 名称和 BSSID。"
          }
        }
      }
    },
    "macOS is using free RAM to keep recently used files handy. This is not a problem and is released the moment anything needs the space." : {
      "comment" : "Identity entries: English renders the key verbatim. Present so the two tables mirror each other and English copy stays auditable in one place; check-localization.py enforces the parity.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nutzt freien RAM, um zuletzt verwendete Dateien griffbereit zu halten. Das ist kein Problem und wird sofort freigegeben, sobald etwas den Platz braucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS is using free RAM to keep recently used files handy. This is not a problem and is released the moment anything needs the space."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS utilise la RAM libre pour garder les fichiers récemment utilisés à portée de main. Ce n'est pas un problème : elle est libérée dès que quelque chose a besoin de cet espace."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 用空闲 RAM 来缓存最近用过的文件。这不是问题，只要有程序需要空间，它会立刻释放。"
          }
        }
      }
    },
    "macOS memory pressure" : {
      "comment" : "Dashboard chart statistics and investigation details. German, French, and Simplified Chinese translations generated by GitHub Copilot; native-speaker review pending.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS-Speicherdruck"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS memory pressure"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pression mémoire macOS"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 内存压力"
          }
        }
      }
    },
    "macOS memory pressure selects the band: normal 0-33, warning 34-66, or critical 67-100. Compression, swap, and their growth place the index within that band. The chart summarizes recorded samples, not a percentage of allocated bytes." : {
      "comment" : "Dashboard chart statistics and investigation details. German, French, and Simplified Chinese translations generated by GitHub Copilot; native-speaker review pending.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der macOS-Speicherdruck wählt den Bereich: normal 0-33, Warnung 34-66 oder kritisch 67-100. Komprimierung, Auslagerung und ihr Wachstum bestimmen die Position des Index im Bereich. Das Diagramm fasst aufgezeichnete Messwerte zusammen, keinen Prozentsatz zugewiesener Bytes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS memory pressure selects the band: normal 0-33, warning 34-66, or critical 67-100. Compression, swap, and their growth place the index within that band. The chart summarizes recorded samples, not a percentage of allocated bytes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pression mémoire macOS définit la bande : normale 0-33, avertissement 34-66 ou critique 67-100. La compression, l’échange et leur croissance placent l’indice dans cette bande. Le graphique résume des échantillons enregistrés, pas un pourcentage d’octets alloués."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 内存压力决定区间：正常为 0-33，警告为 34-66，严重为 67-100。压缩、交换及其增长决定指数在该区间内的位置。图表汇总已记录的样本，而非已分配字节的百分比。"
          }
        }
      }
    },
