    "Average and observed temperature range. Missing sensor readings remain gaps." : {
      "comment" : "Dashboard chart statistics and investigation details. German, French, and Simplified Chinese translations generated by GitHub Copilot; native-speaker review pending.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mittelwert und gemessener Temperaturbereich. Fehlende Sensorwerte bleiben als Lücken sichtbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Average and observed temperature range. Missing sensor readings remain gaps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moyenne et plage de températures observée. Les mesures manquantes restent des lacunes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平均温度和观测温度范围。缺失的传感器读数保留为空白。"
          }
        }
      }
    },
    "Average smooths spikes over the window; Peak shows the highest the group reached." : {
      "comment" : "Identity entries: English renders the key verbatim. Present so the two tables mirror each other and English copy stays auditable in one place; check-localization.py enforces the parity.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Durchschnitt“ glättet Spitzen über das Zeitfenster; „Spitze“ zeigt den höchsten Wert, den die Gruppe erreicht hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Average smooths spikes over the window; Peak shows the highest the group reached."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Moyenne » lisse les pics sur la période ; « Pic » indique la valeur la plus élevée atteinte par le groupe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「平均」会把窗口内的尖峰抹平；「峰值」显示该组达到过的最高值。"
          }
        }
      }
    },
    "Averaging ~{cpu.sustainedPercent}% CPU over the last hour — holding this much CPU for so long usually means a stuck task, a busy loop, or runaway background work, even though it stays below the instantaneous-spike level." : {
      "comment" : "Identity entries: English renders the key verbatim. Present so the two tables mirror each other and English copy stays auditable in one place; check-localization.py enforces the parity.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Durchschnitt ~{cpu.sustainedPercent} % CPU in der letzten Stunde. So viel CPU über so lange Zeit deutet meist auf eine hängende Aufgabe, eine Endlosschleife oder außer Kontrolle geratene Hintergrundarbeit hin, auch wenn der Wert unter der Schwelle für kurzzeitige Spitzen bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Averaging ~{cpu.sustainedPercent}% CPU over the last hour — holding this much CPU for so long usually means a stuck task, a busy loop, or runaway background work, even though it stays below the instantaneous-spike level."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU à ~{cpu.sustainedPercent} % en moyenne sur la dernière heure. Maintenir une telle charge aussi longtemps traduit généralement une tâche bloquée, une boucle active ou un travail d'arrière-plan hors de contrôle, même si le niveau reste sous celui d'un pic instantané."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "过去一小时平均占用约 {cpu.sustainedPercent}% CPU。虽然没达到瞬时尖峰的水平，但这么长时间维持这么高的占用，通常意味着任务卡住、忙循环，或者后台工作失控。"
          }
        }
      }
    },
