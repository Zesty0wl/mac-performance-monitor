    "About GPU clock states" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über GPU-Taktzustände"
          }
        },
        "en" : {
          "stringUnit" : {
