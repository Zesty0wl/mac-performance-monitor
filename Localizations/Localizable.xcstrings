    "GPU has been busy" : {
      "comment" : "Identity entries: English renders the key verbatim. Present so the two tables mirror each other and English copy stays auditable in one place; check-localization.py enforces the parity.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die GPU war stark ausgelastet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU has been busy"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le GPU a été très sollicité"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU 一直很忙"
          }
        }
      }
    },
    "GPU is the share of one GPU the process used over the last few seconds (the figure Activity Monitor calls % GPU); GPU ms/s is the same as milliseconds of GPU time per second. Browsers, Electron apps and Safari do their GPU work in helper processes, which appear under their own names." : {
      "comment" : "Identity entries: English renders the key verbatim. Present so the two tables mirror each other and English copy stays auditable in one place; check-localization.py enforces the parity.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU ist der Anteil einer GPU, den der Prozess in den letzten Sekunden genutzt hat (der Wert, den die Aktivitätsanzeige „% GPU“ nennt); GPU ms/s ist dasselbe in Millisekunden GPU-Zeit pro Sekunde. Browser, Electron-Apps und Safari erledigen ihre GPU-Arbeit in Hilfsprozessen, die unter eigenem Namen erscheinen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU is the share of one GPU the process used over the last few seconds (the figure Activity Monitor calls % GPU); GPU ms/s is the same as milliseconds of GPU time per second. Browsers, Electron apps and Safari do their GPU work in helper processes, which appear under their own names."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU est la part d'un GPU utilisée par le processus au cours des dernières secondes (la valeur que le Moniteur d'activité appelle « % GPU ») ; GPU ms/s est la même chose exprimée en millisecondes de temps GPU par seconde. Les navigateurs, les apps Electron et Safari effectuent leur travail GPU dans des processus auxiliaires, qui apparaissent sous leur propre nom."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU 是该进程在过去几秒内使用的单个 GPU 的比例（即活动监视器中 % GPU 的数值）；GPU ms/s 是每秒的 GPU 时间毫秒数。浏览器、Electron 应用和 Safari 的 GPU 工作在辅助进程中完成，这些进程以各自的名称显示。"
          }
        }
      }
    },
