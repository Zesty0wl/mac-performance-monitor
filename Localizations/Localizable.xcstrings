    "Swap is memory moved out to disk. A flat line at zero is ideal; a sustained climb under pressure is the real warning sign." : {
      "comment" : "DashboardView",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swap ist Speicher, der auf die Festplatte ausgelagert wurde. Eine flache Linie bei null ist ideal; ein anhaltender Anstieg unter Speicherdruck ist das eigentliche Warnsignal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swap is memory moved out to disk. A flat line at zero is ideal; a sustained climb under pressure is the real warning sign."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le swap est de la mémoire déplacée sur le disque. Une ligne plate à zéro est idéale ; une hausse soutenue sous pression est le vrai signal d’alerte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交换内存是被移到磁盘的内存。零位置的水平线是理想状态;压力下的持续攀升才是真正的危险信号。"
          }
        }
      }
    },
