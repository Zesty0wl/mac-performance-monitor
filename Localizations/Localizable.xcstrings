      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freier Speicher wird aus gespeicherten Kategorie-Mittelwerten berechnet. Seine historischen Extremwerte lassen sich daraus nicht wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free memory is derived from stored category averages. Its historical extrema cannot be recovered from those averages."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mémoire libre est calculée à partir des moyennes enregistrées par catégorie. Ses extrema historiques ne peuvent pas être reconstitués à partir de ces moyennes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
