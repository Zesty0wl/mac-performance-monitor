    "250ms and 500ms speed up the live charts and the process rows on screen. The full process scan, the table order, rankings and alerts refresh every 5 s." : {
      "comment" : "Identity entries: English renders the key verbatim. Present so the two tables mirror each other and English copy stays auditable in one place; check-localization.py enforces the parity.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "250 ms und 500 ms beschleunigen die Live-Diagramme und die Prozesszeilen auf dem Bildschirm. Der vollständige Prozess-Scan, die Tabellensortierung, Ranglisten und Warnungen werden alle 5 s aktualisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "250ms and 500ms speed up the live charts and the process rows on screen. The full process scan, the table order, rankings and alerts refresh every 5 s."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "250 ms et 500 ms accélèrent les graphiques en direct et les lignes de processus à l'écran. L'analyse complète des processus, l'ordre de la table, les classements et les alertes sont actualisés toutes les 5 s."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "250 毫秒和 500 毫秒会加快实时图表和屏幕上进程行的刷新。完整的进程扫描、表格排序、排行和提醒仍然每 5 秒刷新一次。"
          }
        }
      }
    },
