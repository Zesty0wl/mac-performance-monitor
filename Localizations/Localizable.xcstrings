    "Footprint stepped from %1$@ to %2$@ at %3$@. A sharp one-off step usually means a heavy document or operation, not a leak." : {
      "comment" : "Identity entries: English renders the key verbatim. Present so the two tables mirror each other and English copy stays auditable in one place; check-localization.py enforces the parity.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Footprint sprang um %3$@ von %1$@ auf %2$@. Ein einzelner scharfer Sprung bedeutet meist ein großes Dokument oder einen aufwendigen Vorgang, kein Leck."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Footprint stepped from %1$@ to %2$@ at %3$@. A sharp one-off step usually means a heavy document or operation, not a leak."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'empreinte est passée de %1$@ à %2$@ à %3$@. Un saut net et ponctuel signifie généralement un document ou une opération lourde, pas une fuite."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %3$@，内存占用从 %1$@ 跃升至 %2$@。一次性的陡升通常意味着打开了大文档或执行了重操作，不是泄漏。"
          }
        }
      }
    },
