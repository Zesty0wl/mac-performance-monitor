        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freier RAM, der als harmloser Dateicache dient und bei Bedarf freigegeben wird. Klicke für Details."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spare RAM used as a benign file cache, released on demand. Click for details."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAM disponible utilisée comme cache de fichiers inoffensif, libérée à la demande. Cliquez pour plus de détails."
