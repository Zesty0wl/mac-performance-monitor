    "Partial readings are lower bounds. Missing readings are gaps." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilweise erfasste Werte sind Untergrenzen. Fehlende Werte bleiben Lücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partial readings are lower bounds. Missing readings are gaps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mesures partielles sont des bornes inférieures. Les mesures manquantes restent des lacunes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不完整的读数仅代表下限。缺失的读数显示为空缺。"
          }
        }
      }
    },
    "Accounted ANE time per second, not percent of compute capacity. Partial readings are lower bounds. Missing readings are gaps." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasste ANE-Zeit pro Sekunde, kein Prozentsatz der Rechenkapazität. Teilweise erfasste Werte sind Untergrenzen. Fehlende Werte bleiben Lücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accounted ANE time per second, not percent of compute capacity. Partial readings are lower bounds. Missing readings are gaps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temps ANE comptabilisé par seconde, pas un pourcentage de capacité de calcul. Les mesures partielles sont des bornes inférieures. Les mesures manquantes restent des lacunes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每秒计入的 ANE 时间，并非计算能力的使用百分比。不完整的读数仅代表下限。缺失的读数显示为空缺。"
          }
        }
      }
    },
    "Accounted Neural Engine time per second, not percent of compute capacity." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasste Neural-Engine-Zeit pro Sekunde, kein Prozentsatz der Rechenkapazität."
          }
        },
        "en" : {
          "stringUnit" : {
