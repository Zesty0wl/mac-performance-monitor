    "Notify when total CPU stays above the chosen level for a sustained period. Off by default: high CPU is normal during real work." : {
      "comment" : "SettingsView",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigen, wenn die gesamte CPU-Auslastung über einen längeren Zeitraum über dem gewählten Wert bleibt. Standardmäßig aus: Hohe CPU-Auslastung ist bei echter Arbeit normal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notify when total CPU stays above the chosen level for a sustained period. Off by default: high CPU is normal during real work."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
