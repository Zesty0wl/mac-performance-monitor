    "Stored sensor intervals contain peaks. The average of those peaks is not a time average." : {
      "comment" : "Explorer peak-only sensor retention limitation. AI-generated translations; native-speaker review pending.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte Sensorintervalle enthalten Spitzenwerte. Deren Mittelwert ist kein zeitlicher Mittelwert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stored sensor intervals contain peaks. The average of those peaks is not a time average."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les intervalles de capteurs conservés contiennent des pics. La moyenne de ces pics n’est pas une moyenne temporelle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留的传感器区间包含峰值。这些峰值的平均值并非时间平均值。"
          }
        }
      }
    },
    "Process averages summarize recorded observations, not continuous activity. Some fields exist only in raw history." : {
      "comment" : "Explorer sparse process observations and raw-only fields. AI-generated translations; native-speaker review pending.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prozessmittelwerte fassen aufgezeichnete Messwerte zusammen, nicht die durchgehende Aktivität. Manche Felder gibt es nur in Rohdaten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Process averages summarize recorded observations, not continuous activity. Some fields exist only in raw history."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les moyennes des processus résument les observations enregistrées, pas l’activité continue. Certains champs existent uniquement dans l’historique brut."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进程平均值汇总的是已记录的观测值，而非连续活动。部分字段仅存在于原始历史数据中。"
          }
        }
      }
    },
    "Stored descriptor counts are interval peaks." : {
