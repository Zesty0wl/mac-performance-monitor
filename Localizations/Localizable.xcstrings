    },
    "macOS thermal pressure. Serious or critical pressure can reduce performance." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thermische Belastung laut macOS. Starke oder kritische Belastung kann die Leistung verringern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS thermal pressure. Serious or critical pressure can reduce performance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pression thermique de macOS. Une pression élevée ou critique peut réduire les performances."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 温度压力。严重或临界压力可能降低性能。"
          }
        }
      }
    },
    "macOS is reporting thermal pressure that can reduce performance. Compare responsiveness when the current workload finishes and the Mac cools down." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS meldet thermische Belastung, die die Leistung verringern kann. Vergleiche die Reaktionsfähigkeit nach Abschluss der aktuellen Arbeit und dem Abkühlen des Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS is reporting thermal pressure that can reduce performance. Compare responsiveness when the current workload finishes and the Mac cools down."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS signale une pression thermique pouvant réduire les performances. Comparez la réactivité quand la tâche actuelle est terminée et que le Mac a refroidi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 报告了可能降低性能的温度压力。当前任务完成且 Mac 冷却后，请比较响应速度。"
          }
        }
      }
    },
    "macOS is reporting memory strain. Check which apps use the most memory and whether responsiveness improves when pressure falls." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS meldet Speicherbelastung. Prüfe, welche Apps am meisten Speicher belegen und ob die Reaktionsfähigkeit bei sinkendem Speicherdruck besser wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS is reporting memory strain. Check which apps use the most memory and whether responsiveness improves when pressure falls."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS signale une tension sur la mémoire. Vérifiez quelles apps utilisent le plus de mémoire et si la réactivité s'améliore quand la pression baisse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 报告内存紧张。请检查哪些 App 占用内存最多，并观察压力下降后响应速度是否改善。"
          }
        }
      }
    },
