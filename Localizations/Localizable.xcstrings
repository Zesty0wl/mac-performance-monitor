          }
        }
      }
    },
    "Approximate GPU memory bandwidth based on buckets reported by macOS. Actual bandwidth may be higher. Missing readings and older logs are gaps." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungefähre GPU-Speicherbandbreite anhand der von macOS gemeldeten Klassen. Die tatsächliche Bandbreite kann höher sein. Fehlende Werte und ältere Aufzeichnungen bleiben Lücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approximate GPU memory bandwidth based on buckets reported by macOS. Actual bandwidth may be higher. Missing readings and older logs are gaps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bande passante mémoire GPU approximative, basée sur les classes signalées par macOS. La bande passante réelle peut être supérieure. Les mesures manquantes et les anciens relevés restent des lacunes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据 macOS 报告的带宽档位估算 GPU 内存带宽。实际带宽可能更高。缺失读数和旧记录显示为空缺。"
          }
        }
      }
    },
    "Estimated average" : {
      "comment" : "GPU bandwidth estimates from event-weighted band labels. AI-generated translations need native review.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschätzter Mittelwert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
