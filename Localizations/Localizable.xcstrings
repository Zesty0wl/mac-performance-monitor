    "Mean attributed disk bytes over observed endpoints, not physical disk saturation." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mittlere zugeordnete Festplatten-Datenrate zwischen beobachteten Endpunkten, keine physische Festplattensättigung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mean attributed disk bytes over observed endpoints, not physical disk saturation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Débit disque moyen attribué entre les points observés, pas une saturation du disque physique."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据观测端点计算的平均归属磁盘数据速率，并非物理磁盘饱和程度。"
          }
        }
      }
    },
    "Highest recorded value, not typical use or proof of a fault. Process CPU is a share of one core." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchster aufgezeichneter Wert, keine typische Nutzung und kein Fehlernachweis. Prozess-CPU bezieht sich auf einen Kern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Highest recorded value, not typical use or proof of a fault. Process CPU is a share of one core."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valeur enregistrée la plus élevée, pas un usage habituel ni une preuve de panne. Le CPU d'un processus est mesuré par rapport à un cœur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录中的最高值，不代表典型用量，也不能证明故障。进程 CPU 用量以单个核心为基准。"
          }
        }
      }
    },
    "Rankings include recorded processes only. Missing or unreadable processes are not idle." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Rangliste enthält nur aufgezeichnete Prozesse. Fehlende oder nicht lesbare Prozesse gelten nicht als inaktiv."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rankings include recorded processes only. Missing or unreadable processes are not idle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le classement inclut uniquement les processus enregistrés. Les processus manquants ou illisibles ne sont pas considérés comme inactifs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "排名仅包含已记录的进程。缺失或无法读取的进程不代表处于空闲状态。"
          }
        }
      }
    },
    "Older records are aggregates. Short spikes and exact timing may be unavailable." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ältere Datensätze sind Zusammenfassungen. Kurze Spitzen und genaue Zeitpunkte sind möglicherweise nicht verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Older records are aggregates. Short spikes and exact timing may be unavailable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les anciens enregistrements sont agrégés. Les pics brefs et leur chronologie exacte peuvent être indisponibles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "较早的记录为汇总数据，可能无法获取短暂峰值和准确时间。"
          }
        }
      }
    },
    "Per-process network history is meaningful only while network tracking was enabled." : {
