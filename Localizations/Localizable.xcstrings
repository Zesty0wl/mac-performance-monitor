    "Items you already removed; the space is not free until the Trash is emptied." : {
      "comment" : "Disk Map (1.6.0)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekte, die du bereits entfernt hast; der Platz wird erst frei, wenn der Papierkorb entleert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items you already removed; the space is not free until the Trash is emptied."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éléments que vous avez déjà supprimés ; l'espace n'est libéré qu'une fois la corbeille vidée."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已移除的项目；清倒废纸篓前空间不会释放。"
          }
        }
      }
    },
    "Its size, age, location and how safe it is to remove appear here, with Reveal in Finder, Quick Look and Move to Trash." : {
      "comment" : "Disk Map (1.6.0)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Größe, Alter, Speicherort und wie sicher das Entfernen ist, erscheinen hier, zusammen mit „Im Finder zeigen“, „Übersicht“ und „In den Papierkorb legen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its size, age, location and how safe it is to remove appear here, with Reveal in Finder, Quick Look and Move to Trash."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa taille, son ancienneté, son emplacement et le risque de la supprimer apparaissent ici, avec Afficher dans le Finder, Coup d'œil et Placer dans la corbeille."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的大小、时间、位置以及移除的安全程度会显示在这里，并提供在访达中显示、快速查看和移到废纸篓。"
          }
        }
      }
    },
    "Keep %@ in the Dock even with no window open." : {
      "comment" : "OnboardingView",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ auch dann im Dock behalten, wenn kein Fenster geöffnet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep %@ in the Dock even with no window open."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garder %@ dans le Dock même quand aucune fenêtre n’est ouverte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使没有打开窗口，也在程序坞中保留 %@。"
          }
        }
      }
    },
    "Keep a local history so the charts can look back, and the leak board and pressure events work." : {
      "comment" : "OnboardingView",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen lokalen Verlauf führen, damit die Diagramme zurückblicken können und das Leak-Board sowie die Druckereignisse funktionieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep a local history so the charts can look back, and the leak board and pressure events work."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserver un historique local pour que les graphiques puissent remonter dans le temps, et que le tableau des fuites et les événements de pression fonctionnent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留本地历史数据，让图表可以回看，并使泄漏榜与压力事件正常工作。"
          }
        }
      }
    },
    "Keep archives of versions still in use; delete the rest in the Organizer." : {
