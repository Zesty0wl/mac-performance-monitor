    "Disk rates use changes in cumulative counters. Resets and long gaps have no rate." : {
      "comment" : "Explorer process disk-rate derivation. AI-generated translations; native-speaker review pending.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenträgerraten beruhen auf Änderungen kumulativer Zähler. Bei Rücksetzungen und langen Lücken gibt es keine Rate."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk rates use changes in cumulative counters. Resets and long gaps have no rate."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les débits disque utilisent les variations des compteurs cumulés. Les réinitialisations et les longues interruptions n’ont pas de débit calculé."
