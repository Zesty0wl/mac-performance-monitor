    "Current swap traffic. Interpret it alongside memory pressure, not stored swap alone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktueller Swap-Datenverkehr. Bewerte ihn zusammen mit dem Speicherdruck, nicht nur dem belegten Swap."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Current swap traffic. Interpret it alongside memory pressure, not stored swap alone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trafic actuel du swap. Interprétez-le avec la pression mémoire, pas seulement avec le swap déjà occupé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前交换空间活动。应结合内存压力判断，而不能只看已占用的交换空间。"
          }
        }
      }
    },
    "Startup disk free percentage" : {
      "extractionState" : "manual",
