          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS n'a pas autorisé %@ à lire ce dossier. L'accès complet au disque le déverrouille."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
