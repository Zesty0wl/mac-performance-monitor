          }
        }
      }
    },
    "Read and write show physical traffic across real internal and external disks. Throughput is not the same as disk capacity, latency, or busy time. A burst can be brief even when its peak is high." : {
      "comment" : "Dashboard chart statistics and investigation details. German, French, and Simplified Chinese translations generated by GitHub Copilot; native-speaker review pending.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lesen und Schreiben zeigen physischen Datenverkehr auf echten internen und externen Datenträgern. Durchsatz ist nicht dasselbe wie Kapazität, Latenz oder aktive Zeit. Eine Spitze kann trotz hohem Höchstwert nur kurz dauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read and write show physical traffic across real internal and external disks. Throughput is not the same as disk capacity, latency, or busy time. A burst can be brief even when its peak is high."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lecture et l’écriture montrent le trafic physique des disques internes et externes réels. Le débit diffère de la capacité, de la latence ou du temps d’activité. Un pic peut être bref même si son maximum est élevé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取和写入显示实际内置和外置磁盘的物理流量。吞吐量不同于磁盘容量、延迟或繁忙时间。即使峰值很高，突发也可能十分短暂。"
          }
        }
      }
    },
